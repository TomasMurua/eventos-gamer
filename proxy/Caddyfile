# Proxy inverso de LJCS: unico punto de entrada desde Internet.
# Caddy obtiene y renueva solo el certificado TLS de Let's Encrypt para el dominio.
{
	servers {
		protocols h1 h2
	}
}

{$DOMINIO} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
		-Via
		-X-Powered-By
	}

	# API REST del backend
	handle /api/* {
		reverse_proxy backend:8081
	}

	# Paginas del frontend
	handle {
		reverse_proxy frontend:8080
	}

	log {
		output stdout
		format console
	}
}

# Acceso por IP o por HTTP: todo se redirige al dominio con HTTPS, conservando la ruta (ej. /eventos)
:80 {
	header -Server
	redir https://{$DOMINIO}{uri} permanent
}
